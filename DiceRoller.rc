#include "Resource.h"
#include <windows.h>
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
IDI_DICEROLLER ICON "DiceRoller.ico"
IDI_SMALL ICON "small.ico"
IDC_DICEROLLER MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit", IDM_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Dice Roller...\tF1", IDM_ABOUT
    END
END
IDC_DICEROLLER ACCELERATORS
BEGIN
    VK_F1, IDM_ABOUT, VIRTKEY
END
IDD_ABOUTBOX DIALOGEX 0, 0, 250, 106
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Dice Roller"
FONT 9, "Segoe UI"
BEGIN
    ICON IDI_DICEROLLER,IDC_STATIC,12,12,21,20
    LTEXT "Dice Roller - Win32 desktop application",IDC_STATIC,42,12,196,12
    LTEXT "Advantage / Disadvantage compares two complete dice groups.",IDC_STATIC,12,40,226,24
    LTEXT "Local history, recovery and deduplicated CSV v3 exports.",IDC_STATIC,12,66,226,12
    DEFPUSHBUTTON "OK",IDOK,188,84,50,14,WS_GROUP
END
STRINGTABLE
BEGIN
    IDS_APP_TITLE "Dice Roller"
END
